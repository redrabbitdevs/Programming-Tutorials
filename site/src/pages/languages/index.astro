---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { STATUS_LABEL, TIER_INFO, languageHref } from '../../lib/lessons';

const all = (await getCollection('languages')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const tiers = ([1, 2, 3] as const).map((t) => ({ tier: t, items: all.filter((l) => l.data.tier === t) })).filter((g) => g.items.length);
const paradigms = [...new Set(all.flatMap((l) => l.data.paradigm))].sort((a, b) => a.localeCompare(b));
---

<BaseLayout title="Languages" section="languages" description="Every programming language in the catalogue, grouped by tier, with search and filters.">
  <div class="page-head">
    <div class="wrap">
      <h1>Languages</h1>
      <p class="lede">
        {all.length} {all.length === 1 ? 'language' : 'languages'}, grouped by how deeply they are covered. Search by name,
        paradigm or a word from the summary.
      </p>
    </div>
  </div>

  <div class="wrap" id="directory">
    <form class="filters" role="search" aria-label="Filter languages" onsubmit="return false">
      <div class="field">
        <label for="f-q">Search</label>
        <input id="f-q" type="search" autocomplete="off" placeholder="Name, paradigm or keyword" />
      </div>
      <div class="field">
        <label for="f-status">Status</label>
        <select id="f-status">
          <option value="">Any status</option>
          <option value="complete">Complete</option>
          <option value="in-progress">In progress</option>
          <option value="planned">Planned</option>
        </select>
      </div>
      <div class="field">
        <label for="f-par">Paradigm</label>
        <select id="f-par">
          <option value="">Any paradigm</option>
          {paradigms.map((p) => <option value={p.toLowerCase()}>{p}</option>)}
        </select>
      </div>
    </form>

    <p class="result-count" id="count" role="status" aria-live="polite"></p>

    {tiers.map((g) => (
      <section class="tier-group" aria-labelledby={`tier-${g.tier}`} data-tier={g.tier}>
        <header>
          <h2 id={`tier-${g.tier}`}>{TIER_INFO[g.tier].title}</h2>
          <p>{TIER_INFO[g.tier].note}. <span class="tier-n">{g.items.length}</span> shown</p>
        </header>
        <ul class="lang-list">
          {g.items.map((l) => (
            <li
              data-status={l.data.status}
              data-par={l.data.paradigm.join('|').toLowerCase()}
              data-q={`${l.data.name} ${l.data.slug} ${l.data.paradigm.join(' ')} ${l.data.summary}`.toLowerCase()}
            >
              <a class="lang-row" href={languageHref(l.data.slug)}>
                <span class="name">{l.data.name}</span>
                <span class="summary">{l.data.summary}</span>
                <span class="tags">{l.data.paradigm.join(', ')}</span>
                <span class="status" data-status={l.data.status}>{STATUS_LABEL[l.data.status]}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <p class="empty" id="none" hidden>No languages match. Clear the search or pick a different filter.</p>
  </div>
</BaseLayout>

<script>
  const q = document.getElementById('f-q') as HTMLInputElement;
  const st = document.getElementById('f-status') as HTMLSelectElement;
  const par = document.getElementById('f-par') as HTMLSelectElement;
  const count = document.getElementById('count')!;
  const none = document.getElementById('none')!;
  const groups = Array.from(document.querySelectorAll<HTMLElement>('.tier-group'));
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.lang-list > li')).map((el) => ({
    el,
    q: el.dataset.q ?? '',
    status: el.dataset.status ?? '',
    par: (el.dataset.par ?? '').split('|'),
  }));

  const params = new URLSearchParams(location.search);
  q.value = params.get('q') ?? '';
  st.value = params.get('status') ?? '';
  par.value = params.get('par') ?? '';

  function apply() {
    const terms = q.value.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const r of rows) {
      const ok =
        terms.every((t) => r.q.includes(t)) &&
        (!st.value || r.status === st.value) &&
        (!par.value || r.par.includes(par.value));
      r.el.hidden = !ok;
      if (ok) shown++;
    }
    for (const g of groups) {
      const n = g.querySelectorAll('.lang-list > li:not([hidden])').length;
      g.hidden = n === 0;
      const label = g.querySelector('.tier-n');
      if (label) label.textContent = String(n);
    }
    none.hidden = shown !== 0;
    count.textContent = `${shown} of ${rows.length} ${rows.length === 1 ? 'language' : 'languages'}`;

    const next = new URLSearchParams();
    if (q.value) next.set('q', q.value);
    if (st.value) next.set('status', st.value);
    if (par.value) next.set('par', par.value);
    const s = next.toString();
    history.replaceState(null, '', s ? `?${s}` : location.pathname);
  }

  let timer: number | undefined;
  q.addEventListener('input', () => {
    clearTimeout(timer);
    timer = window.setTimeout(apply, 80);
  });
  st.addEventListener('change', apply);
  par.addEventListener('change', apply);
  apply();
</script>
