---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Crumbs from '../../../components/Crumbs.astro';
import { url } from '../../../lib/url';
import { showVersionBadge, versionBadgeText } from '../../../lib/versions';
import { STATUS_LABEL, getLessonsFor, groupLessons, lessonHref, languageHref } from '../../../lib/lessons';
import { paradigmGroups, groupLabel } from '../../../lib/paradigms';

export async function getStaticPaths() {
  const langs = await getCollection('languages');
  return langs.map((l) => ({ params: { lang: l.data.slug }, props: { language: l } }));
}

const { language } = Astro.props;
const d = language.data;
const lessons = await getLessonsFor(d.slug);
const groups = groupLessons(lessons, d.levels);
const levelLinks = groups.filter((g) => g.modules.length > 0).map((g) => ({
  id: g.level.id,
  label: g.level.label,
  count: g.modules.reduce((n, m) => n + m.lessons.length, 0),
}));
const first = lessons[0];
const fmtDate = (x: Date) => x.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', timeZone: 'UTC' });
const overviewOnly = lessons.length === 0;
const shownGroups = paradigmGroups(d.paradigm).filter((g) => g !== 'other').map(groupLabel);
// Optional: only rendered if the language data carries a Wikipedia URL.
const wikipedia = (d as { wikipedia?: string }).wikipedia;
---

<BaseLayout title={overviewOnly ? d.name : `${d.name} curriculum`} section="languages" description={d.summary}>
  {overviewOnly ? (
    <div class="page-head">
      <div class="wrap">
        <Crumbs items={[{ label: 'Languages', href: url('/languages/') }, { label: d.name }]} />
        <h1>{d.name}</h1>
        <p class="lede">{d.summary}</p>
      </div>
    </div>
    <div class="wrap overview">
      <dl class="facts">
        {shownGroups.length > 0 && (
          <div><dt>{shownGroups.length === 1 ? 'Paradigm' : 'Paradigms'}</dt><dd>{shownGroups.join(', ')}</dd></div>
        )}
        {d.firstAppeared && <div><dt>First appeared</dt><dd>{d.firstAppeared}</dd></div>}
        {wikipedia && <div><dt>Reference</dt><dd><a href={wikipedia} rel="noopener">Wikipedia article</a></dd></div>}
      </dl>
      <aside class="not-yet" aria-labelledby="not-yet">
        <h2 id="not-yet">Not yet on the curriculum</h2>
        <p>
          There are no {d.name} lessons yet. The ideas that carry across every language, such as variables, control flow and
          functions, are covered in <a href={url('/fundamentals/')}>Fundamentals</a>. For a full track to see how lessons
          are structured, start with <a href={languageHref('python')}>Python</a>.
        </p>
      </aside>
    </div>
  ) : (
  <Fragment>
  <div class="page-head">
    <div class="wrap">
      <Crumbs items={[{ label: 'Languages', href: url('/languages/') }, { label: d.name }]} />
      <h1>{d.name}</h1>
      <p class="lede">{d.summary}</p>
      <dl class="meta-row">
        <div><dt>Status</dt><dd><span class="status" data-status={d.status}>{STATUS_LABEL[d.status]}</span></dd></div>
        <div><dt>Paradigm</dt><dd>{shownGroups.join(', ').toLowerCase() || 'other'}</dd></div>
        {d.firstAppeared && <div><dt>First appeared</dt><dd>{d.firstAppeared}</dd></div>}
        {d.latestVersion && (
          <div>
            <dt>Latest version</dt>
            <dd>{d.versionLabel ? `${d.versionLabel} ` : ''}{d.latestVersion}{d.latestVersionDate && <span> ({fmtDate(d.latestVersionDate)})</span>}</dd>
          </div>
        )}
        {d.latestEdition && <div><dt>Latest standard</dt><dd>{d.latestEdition}</dd></div>}
        <div><dt>Lessons</dt><dd>{lessons.length}</dd></div>
      </dl>
      {levelLinks.length > 1 && (
        <nav class="level-jump" aria-label="Jump to a level">
          <ul>
            {levelLinks.map((l) => (
              <li><a href={`#lv-${l.id}`}>{l.label} <span class="n">{l.count}</span></a></li>
            ))}
          </ul>
        </nav>
      )}
      {first && (
        <div class="hero-actions">
          <a class="btn" href={lessonHref(first)}>Start: {first.data.title}</a>
        </div>
      )}
    </div>
  </div>

  <div class="wrap curriculum">
    {groups.map((g) => (
      <section class="level-block" aria-labelledby={`lv-${g.level.id}`}>
        <header>
          <h2 id={`lv-${g.level.id}`}>{g.level.label}</h2>
          <p>{g.level.blurb}</p>
        </header>
        {g.modules.length === 0 ? (
          <p class="empty">Not written yet.</p>
        ) : (
          g.modules.map((m) => (
            <div class="module">
              <h3>{m.name}</h3>
              <ol class="lesson-list">
                {m.lessons.map((l) => (
                  <li>
                    <a href={lessonHref(l)}>
                      <span class="t">{l.data.title}</span>
                      <span class="m">{l.data.estimatedMinutes} min{showVersionBadge(l.data.language, l.data.minVersion) ? ` · ${versionBadgeText(d.name, d.versionLabel, l.data.minVersion)}` : ''}</span>
                      <span class="d">{l.data.description}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          ))
        )}
      </section>
    ))}
  </div>
  </Fragment>
  )}
</BaseLayout>
