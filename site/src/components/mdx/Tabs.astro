---
/**
 * <Tabs> <Tab label="macOS">...</Tab> <Tab label="Windows">...</Tab> </Tabs>
 * Without JavaScript every panel is shown under its label. With JavaScript
 * it becomes a WAI-ARIA tabs widget (arrow keys, Home, End). Groups that share
 * a label switch together, and the choice is remembered in localStorage.
 * OS labels (Windows, macOS, Linux) sync separately from language labels.
 */
---

<div class="tabs" data-tabs><slot /></div>

<script>
  let uid = 0;
  type Group = { key: string; select: (label: string) => boolean };
  const groups: Group[] = [];
  const OS = new Set(['windows', 'macos', 'linux']);
  const store = {
    get(k: string) { try { return localStorage.getItem(k); } catch { return null; } },
    set(k: string, v: string) { try { localStorage.setItem(k, v); } catch { /* storage blocked */ } },
  };
  const syncAll = (key: string, label: string, except?: Group) => {
    groups.forEach((g) => { if (g !== except && g.key === key) g.select(label); });
  };
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const panels = Array.from(root.querySelectorAll<HTMLElement>(':scope > .tab-panel'));
    if (panels.length < 2) return;
    const id = `tabs-${++uid}`;
    const list = document.createElement('div');
    list.setAttribute('role', 'tablist');
    const tabs: HTMLButtonElement[] = [];
    const labels = panels.map((p) => p.dataset.tabLabel ?? '');
    const key = 'tabs:' + (labels.some((l) => OS.has(l.toLowerCase())) ? 'os' : 'lang');

    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        const on = i === j;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        panels[j].hidden = !on;
      });
      if (focus) tabs[i].focus();
    };

    const self: Group = {
      key,
      select: (label) => {
        const i = labels.indexOf(label);
        if (i < 0) return false;
        select(i);
        return true;
      },
    };
    groups.push(self);
    const choose = (i: number, focus = false) => {
      select(i, focus);
      store.set(key, labels[i]);
      syncAll(key, labels[i], self);
    };

    panels.forEach((p, i) => {
      const t = document.createElement('button');
      t.type = 'button';
      t.setAttribute('role', 'tab');
      t.id = `${id}-t${i}`;
      t.setAttribute('aria-controls', `${id}-p${i}`);
      t.textContent = p.dataset.tabLabel ?? `Tab ${i + 1}`;
      t.addEventListener('click', () => choose(i));
      t.addEventListener('keydown', (e) => {
        const n = tabs.length;
        const k = e.key;
        if (k === 'ArrowRight') choose((i + 1) % n, true);
        else if (k === 'ArrowLeft') choose((i - 1 + n) % n, true);
        else if (k === 'Home') choose(0, true);
        else if (k === 'End') choose(n - 1, true);
        else return;
        e.preventDefault();
      });
      tabs.push(t);
      list.appendChild(t);
      p.setAttribute('role', 'tabpanel');
      p.id = `${id}-p${i}`;
      p.setAttribute('aria-labelledby', t.id);
    });

    root.prepend(list);
    root.classList.add('is-enhanced');
    select(Math.max(0, labels.indexOf(store.get(key) ?? '')));
  });
</script>
