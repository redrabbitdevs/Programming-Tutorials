---
/** <Exercise title="..."> prompt, then an optional <Solution> ... </Solution> </Exercise> */
interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<section class="exercise" aria-label={title ? `Exercise: ${title}` : 'Exercise'}>
  <div class="exercise-head">
    <span class="label">Exercise</span>
    {title && <span class="ttl">{title}</span>}
  </div>
  <div class="exercise-body"><slot /></div>
</section>
